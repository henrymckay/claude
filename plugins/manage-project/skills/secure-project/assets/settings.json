{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(*.p12)",
      "Read(id_rsa*)",
      "Read(id_ecdsa*)",
      "Read(id_ed25519*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.git-credentials)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/**)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/Library/Keychains/**)",
      "Edit(.git/**)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push *--force*)",
      "Bash(git push * -f*)",
      "Bash(git push *+*)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)",
      "Bash(security find-*)",
      "Bash(security dump-keychain*)"
    ],
    "ask": [
      "Edit(.claude/**)",
      "Edit(.github/workflows/**)",
      "Edit(.pre-commit-config.yaml)",
      "Edit(CLAUDE.md)",
      "Bash(git reset --hard*)",
      "Bash(git rebase *)",
      "Bash(git commit --amend*)",
      "Bash(git clean -f*)",
      "Bash(git branch -D *)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(gh repo delete*)",
      "Bash(printenv*)",
      "Bash(env)",
      "mcp__*order*",
      "mcp__*convert*",
      "mcp__*transfer*",
      "mcp__*withdraw*",
      "mcp__*pay*",
      "mcp__*close_position*",
      "mcp__*send*",
      "mcp__*reply*",
      "mcp__*forward*",
      "mcp__*post*",
      "mcp__*publish*",
      "mcp__*share*",
      "mcp__*delete*",
      "mcp__*trash*"
    ]
  }
}
