    "ask": [
      "Edit(.claude/**)",
      "Edit(.github/workflows/**)",
      "Edit(.pre-commit-config.yaml)",
      "Edit(CLAUDE.md)",
      "Bash(git reset *--hard*)",
      "Bash(git rebase *)",
      "Bash(git commit *--amend*)",
      "Bash(git clean *)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git branch *-D*)",
      "Bash(git branch *--delete*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(gh repo delete*)",
      "Bash(printenv*)",
      "Bash(env)",
      "Bash(export)",
      "Bash(export -p*)",
      "Bash(set)",
      "mcp__*order*",
      "mcp__*convert*",
      "mcp__*transfer*",
      "mcp__*withdraw*",
      "mcp__*pay*",
      "mcp__*close_position*",
      "mcp__*send*",
      "mcp__*reply*",
      "mcp__*forward*",
      "mcp__*post*",
      "mcp__*publish*",
      "mcp__*share*",
      "mcp__*delete*",
      "mcp__*trash*"
    ]
  }
