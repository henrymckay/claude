{
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PLUGIN_ROOT}/hooks/compact.md\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|Read|NotebookRead|Grep|Glob|Write|Edit|MultiEdit|NotebookEdit|WebFetch|WebSearch|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/skills/secure-project/scripts/guard.sh\"",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\""
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^(?!(Explore|Plan|fork)$)",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\""
          }
        ]
      }
    ]
  }
}
